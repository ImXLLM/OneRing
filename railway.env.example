# ═══════════════════════════════════════════════════════════════════════════
#  KIAN v1.0.0-final — Railway Environment (all 37 variables, priority-ranked)
#  این فایل را در Railway → Variables → Raw Editor کپی کنید.
#  Copy this file into Railway → Variables → Raw Editor.
#
#  اولویت‌بندی:
#    P0  بحرانی — بدون این‌ها سرویس بالا نمی‌آید یا احراز هویت می‌شکند
#    P1  کانال تلگرام — بات و مینی‌اپ
#    P2  اقتصاد و خزانه — ضرب، نرخ‌ها، پارلمان
#    P3  گیت‌وی AI — سه اسلات فال‌بک
#    P4  هاردنینگ و تیونینگ تولید
#    P5  سرویس‌های فرانتاند (هر اپ یک سرویس جدا در Railway)
#
#  پوشش: ۳۶ متغیرِ ران‌تایم که کد واقعاً می‌خواند (config.rs · gateway.rs · اپ‌های Next.js)
#  + ۱ متغیر بیلد Railpack (RAILPACK_CARGO_WORKSPACE). هیچ متغیر دیگری لازم نیست.
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
# P0 — بحرانی: بوت + احراز هویت + امنیت
# ───────────────────────────────────────────────────────────────────────────

# توکن بات تلگرام — مبنای HMAC احراز initData.
# fail-closed: خالی بماند، هیچ کلاینتی نمی‌تواند احراز شود (کل اکوسیستم قفل است).
# از @BotFather بگیرید. هرگز لاگ یا روی سیم نمی‌رود.
KIAN_BOT_TOKEN=

# دیتابیس SQLite — روی Railway باید داخل حجم دائمی (Volume) باشد.
# ۱) در Railway یک Volume به مسیر /app/data وصل کنید
# ۲) مسیر زیر دقیقاً داخل همان حجم باشد
# WAL خودکار فعال می‌شود؛ چند اینستنس روی یک فایل اشتراکی ممنوع (یک اینستنس).
KIAN_DATABASE_URL=/app/data/kian.sqlite

# bind host — روی Railway باید 0.0.0.0 باشد (پیش‌فرض 127.0.0.1 فقط لوکال).
# بدون این مقدار، healthcheck Railway هرگز پاس نمی‌شود.
KIAN_HOST=0.0.0.0

# پورت bind — پیش‌فرض 8088. در تنظیمات سرویس، پورت عمومی را روی همین بگذارید
# (یا KIAN_PORT=${{PORT}} بنویسید تا پورت خود Railway بسته شود).
KIAN_PORT=8088

# اعتماد به X-Forwarded-For — پشت Railway/proxy: true (پیش‌فرض).
# استقرار مستقیم بدون پروکسی → false تا هدر جعلی سقف نرخ را دور نزند.
KIAN_TRUST_PROXY=true

# کلید ادمین (حداقل ۱۶ کاراکتر) — پنل عملیات و مسیرهای /admin.
# fail-closed: خالی بماند، ادمین غیرفعال است. رندم قوی بگذارید:
# openssl rand -hex 24
KIAN_ADMIN_KEY=

# متغیر بیلد Railpack (نه ران‌تایم) — انتخاب قطعی باینری دیپلوی از ورک‌اسپیس.
# کدِ ریشه همین را تضمین می‌کند (crates/server مقدارهای مستقیم دارد)؛ این متغیر
# حکم کمربند و بند است: اگر روزی بقیهٔ کرت‌ها هم مستقیم شدند، انتخاب عوض نشود.
RAILPACK_CARGO_WORKSPACE=kian-server


# ───────────────────────────────────────────────────────────────────────────
# P1 — کانال تلگرام: وبهوک و مینی‌اپ
# ───────────────────────────────────────────────────────────────────────────

# راز وبهوک رسمی تلگرام (حداقل ۱۶ کاراکتر) — هدر X-Telegram-Bot-Api-Secret-Token.
# fail-closed: خالی بماند، وبهوک بات خاموش است. رندم قوی:
# openssl rand -hex 16
# بعد از دیپلوی با همین مقدار setWebhook را صدا بزنید (README → Telegram webhook).
KIAN_BOT_WEBHOOK_SECRET=

# دکمهٔ «ورود به مینی‌اپ» در پاسخ‌های بات — پیش‌فرض localhost:3000.
KIAN_MINIAPP_URL=https://t.me/ZeroXmain_Bot


# ───────────────────────────────────────────────────────────────────────────
# P2 — اقتصاد ملی: ضرب، نرخ تبدیل، خزانهٔ چهارزنجیره، پارلمان
# ───────────────────────────────────────────────────────────────────────────

# آدرس خزانهٔ واریز TON — واریزهای مینی‌اپ به این آدرس ضرب می‌شود.
KIAN_TON_TREASURY=

# نرخ ضرب مادهٔ ۳ — پیش‌فرض ۱۰۰۰ Đ/TON. خالی = پیش‌فرض.
KIAN_TON_TO_DIN=1000

# نرخ ضرب USDT — پیش‌فرض ۱۰۰۰ Đ/USDT. خالی = پیش‌فرض.
KIAN_USDT_TO_DIN=1000

# آدرس خزانهٔ هر زنجیره — شفاف عمومی در GET /wallet/treasury.
# خالی = آن زنجیره در پاسخ خزانه باطل (null) می‌آید.
KIAN_TREASURY_TRX=
KIAN_TREASURY_SOL=
KIAN_TREASURY_TON=
KIAN_TREASURY_BSC=

# نصاب پارلمان HITL — حداقل رأی برای تصویب. پیش‌فرض ۳.
KIAN_NATION_QUORUM=3


# ───────────────────────────────────────────────────────────────────────────
# P3 — گیت‌وی AI: سه اسلات فال‌بک به ترتیب primary → secondary → tertiary
#      خالی بودن همه = گیت‌وی صادقانه «disabled» (سرور سالم می‌ماند).
#      توصیه: حداقل primary + secondary (فال‌بک واقعی).
#      فقط URL+KEY+MODEL کامل یک اسلات = فعال.
# ───────────────────────────────────────────────────────────────────────────

# اسلات اول (اصلی)
KIAN_AI_PRIMARY_URL=
KIAN_AI_PRIMARY_KEY=
KIAN_AI_PRIMARY_MODEL=

# فال‌بک ۱ — با ازکارافتادن primary خودکار جایگزین می‌شود
KIAN_AI_SECONDARY_URL=
KIAN_AI_SECONDARY_KEY=
KIAN_AI_SECONDARY_MODEL=

# فال‌بک ۲ (اختیاری)
KIAN_AI_TERTIARY_URL=
KIAN_AI_TERTIARY_KEY=
KIAN_AI_TERTIARY_MODEL=

# سقف روزانهٔ توکن کل گیت‌وی — پیش‌فرض ۵۰٬۰۰۰.
KIAN_AI_DAILY_TOKENS=50000


# ───────────────────────────────────────────────────────────────────────────
# P4 — هاردنینگ و تیونینگ تولید
# ───────────────────────────────────────────────────────────────────────────

# اوریجین‌های مجاز CORS (کاما جدا) — مینی‌اپ وب و داشبورد.
# fail-closed: خالی = فقط localhost:3000. دامنه‌های واقعی Railway را بگذارید.
KIAN_CORS_ORIGIN=https://<your-web>.up.railway.app,https://<your-admin>.up.railway.app

# عمر نشست bearer به ساعت — پیش‌فرض ۱۶۸ (۷ روز).
KIAN_SESSION_TTL_HOURS=168

# سقف درخواست در پنجرهٔ ۶۰ثانیه‌ای هر باکت — پیش‌فرض ۱۲۰.
# ظرفیت تست‌شده تا ۱٬۵۰۰ کاربر هم‌زمان؛ برای شروع همین پیش‌فرض درست است.
KIAN_RATE_LIMIT=120

# تعداد بکاپ نگه‌داشتنی (VACUUM INTO) — پیش‌فرض ۷.
KIAN_KEEP_BACKUPS=7

# پوشهٔ بکاپ‌ها — روی Railway داخل همان Volume دیتابیس.
KIAN_BACKUP_DIR=/app/data/backups

# فقط اگر بات طول‌کشی (kian-bot) را به‌عنوان سرویسِ دومِ جدا دیپلوی کنید:
# آدرس داخلی سرویس کرنل — Railway internal DNS.
# اگر فقط kian-server را دیپلوی می‌کنید (شِل وبهوک داخل خودش)، خالی بگذارید.
KIAN_KERNEL_URL=


# ───────────────────────────────────────────────────────────────────────────
# P5 — سرویس‌های فرانتاند (متغیرهای جدا برای هر سرویس در Railway)
#      Next.js این‌ها را در زمان BUILD می‌خواند — بعد از هر تغییر redeploy لازم است.
# ───────────────────────────────────────────────────────────────────────────

# ── سرویس apps/web ──
# آدرس عمومی خود سایت
NEXT_PUBLIC_SITE_URL=
# آدرس عمومی سایت در مکان‌های دیگری که لازم است (share و …)
NEXT_PUBLIC_KIAN_URL=
# پایهٔ API کرنل برای کلاینت — دامنهٔ عمومی سرویس kian-server
NEXT_PUBLIC_KIAN_API=

# ── سرویس apps/miniapp (مینی‌اپ تلگرام + استودیو AI + رفرال) ──
# پایهٔ API کرنل برای کلاینت — دامنهٔ عمومی سرویس kian-server همراه با /api/v1
NEXT_PUBLIC_KIAN_API=
# یوزرنیم بات تلگرام بدون @ — برای ساخت لینک‌های وایرال https://t.me/<BOT>?startapp=p_<id>_r_<tgId>
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# ── سرویس apps/admin ──
# پایهٔ API کرنل برای پنل ادمین
NEXT_PUBLIC_KERNEL_URL=


# ═══════════════════════════════════════════════════════════════════════════
#  چک‌لیست بعد از دیپلوی
# ═══════════════════════════════════════════════════════════════════════════
#  □ Volume روی /app/data وصل شده (وگرنه دیتا با هر دیپلوی می‌پرد)
#  □ پورت عمومی سرویس = KIAN_PORT (8088)
#  □ curl https://<دامنه>/health → 200
#  □ setWebhook با secret_token=KIAN_BOT_WEBHOOK_SECRET صدا زده شد
#  □ KIAN_CORS_ORIGIN دامنه‌های واقعی web/miniapp را دارد
#  □ /ai/status اسلات‌های فعال را نشان می‌دهد
#  □ دو راز P0 (ADMIN_KEY و WEBHOOK_SECRET) با openssl rand ساخته شده‌اند
# ═══════════════════════════════════════════════════════════════════════════
