# ═══════════════════════════════════════════════════════════════════════════
#  KIAN v2 — Railway Environment (P0 → P5, strictly priority-ordered)
#  Usage: copy this file into Railway → Variables → Raw Editor.
#  Copy this file into Railway → Variables → Raw Editor. Order = operational
#  priority: most important first — from critical boot to optional tuning.
#
#  Coverage: every runtime variable the code actually reads (config.rs · gateway.rs ·
#  opencode_zen.rs · start-railway.sh · Next.js apps) + 1 Railpack build variable.
#  No other variables are required.
# ═══════════════════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 1 — P0: CRITICAL BOOT, NETWORK & PERSISTENT STORAGE]
#  Most critical — without these the service will not boot or sovereign data is lost.
# ═══════════════════════════════════════════════════════════════════════════

# SQLite database — inside the persistent volume:
#  1) Attach a Railway Volume mounted at /data
#  2) The path below must live exactly inside that volume
# WAL is enabled automatically; never share the file across instances (single instance only).
KIAN_DATABASE_URL=/data/kian.sqlite

# bind host — on Railway always 0.0.0.0 (default 127.0.0.1 is local-only;
# without this value the Railway healthcheck never passes).
KIAN_HOST=0.0.0.0

# bind port — set the service public port to this, or bind it to the Railway-provided port:
KIAN_PORT=${{PORT}}

# Seed source on first boot — copied in if the database file is missing; untouched afterwards
# (idempotent; start-railway.sh).
KIAN_SEED_DATABASE_PATH=/app/seed/kian-production.db

# VACUUM INTO backups — inside the same database volume:
KIAN_BACKUP_DIR=/data/backups
KIAN_KEEP_BACKUPS=7


# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 2 — P1: SOVEREIGN SECURITY, AUTH & ADMIN GATES (FAIL-CLOSED)]
#  Every empty variable means the honest "disabled" level, not an insecure one.
# ═══════════════════════════════════════════════════════════════════════════

# Admin key (min 16 chars) — operations panel and /admin routes. Strong random:
#   openssl rand -hex 24
KIAN_ADMIN_KEY=replace-with-32-char-sovereign-admin-key-min16

# Trust X-Forwarded-For — behind Railway/proxy: true (default).
# Direct deployment without a proxy → false so a forged header cannot bypass the rate cap.
KIAN_TRUST_PROXY=true

# Allowed CORS origins (comma-separated) — set the real web/miniapp domains here:
KIAN_CORS_ORIGIN=https://<your-web>.up.railway.app,https://<your-miniapp>.up.railway.app,https://web.telegram.org

# D1 (forensic audit #27) — fully fail-closed: only "1"/"true"/"yes" turns it on;
# a missing flag or any other value stays off even without a bot token. Keep 0 in production:
KIAN_DEV_MODE=0


# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 3 — P2: AI INFERENCE MESH — ZERO-COST KEYLESS FIRST, SLOTS NEXT]
#  The built-in OpenCode Zen lane (Bearer public) works keyless and card-free;
#  the slots below are optional. All empty = gateway honestly reports "disabled"
#  (server stays healthy). Only a complete URL+KEY+MODEL slot = active.
# ═══════════════════════════════════════════════════════════════════════════

# Dedicated OpenCode key (optional — default is keyless: Bearer public):
OPENCODE_API_KEY=

# Single-gateway shortcut (multi-model routers such as router9):
KIAN_AI_BASE_URL=
KIAN_AI_API_KEY=
KIAN_AI_MODEL=
KIAN_AI_FALLBACK_MODEL=
KIAN_AI_FALLBACK_URL=
KIAN_AI_FALLBACK_KEY=

# First (primary) slot — e.g. https://openrouter.ai/api/v1
KIAN_AI_PRIMARY_URL=
KIAN_AI_PRIMARY_KEY=
KIAN_AI_PRIMARY_MODEL=

# Fallback 1 — automatically replaces primary when it fails:
KIAN_AI_SECONDARY_URL=
KIAN_AI_SECONDARY_KEY=
KIAN_AI_SECONDARY_MODEL=

# Fallback 2 (optional):
KIAN_AI_TERTIARY_URL=
KIAN_AI_TERTIARY_KEY=
KIAN_AI_TERTIARY_MODEL=

# ShopifyHermes-style providers (optional; order: coarena ← openrouter ← router9):
KIAN_AI_COARENA_URL=
KIAN_AI_COARENA_KEY=
KIAN_AI_COARENA_KEYS=
KIAN_AI_COARENA_MODELS=
KIAN_AI_OPENROUTER_URL=
KIAN_AI_OPENROUTER_KEY=
KIAN_AI_OPENROUTER_KEYS=
KIAN_AI_OPENROUTER_MODELS=
KIAN_AI_ROUTER9_URL=
KIAN_AI_ROUTER9_KEY=
KIAN_AI_ROUTER9_KEYS=
KIAN_AI_ROUTER9_MODELS=

# Daily token cap for the whole pool — default 50,000:
KIAN_AI_DAILY_TOKENS=50000


# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 4 — P3: TELEGRAM BOT & MINI-APP (TMA) BRIDGE]
#  Bot token = HMAC basis for initData auth; fail-closed: empty = the whole ecosystem locked.
# ═══════════════════════════════════════════════════════════════════════════

# Telegram bot token — get it from @BotFather. Never logged or sent over the wire.
KIAN_BOT_TOKEN=

# Official Telegram webhook secret (min 16 chars) — X-Telegram-Bot-Api-Secret-Token header.
# fail-closed: if left empty the bot webhook stays off. Strong random:
#   openssl rand -hex 16
# After deploy, call setWebhook with this exact value (README → Telegram webhook).
KIAN_BOT_WEBHOOK_SECRET=

# "Open Mini App" button in bot responses — the real mini-app domain:
KIAN_MINIAPP_URL=https://t.me/ZeroXmain_Bot

# Only if you deploy the long-polling shell (kian-bot) as a separate second service:
# Internal URL of the kernel service — Railway internal DNS. Otherwise leave empty.
KIAN_KERNEL_URL=

# ── Frontend build-time variables ──
# Kernel API base for the mini-app client — public domain of the kian-server service with /api/v1:
NEXT_PUBLIC_KIAN_API=https://<your-kernel>.up.railway.app/api/v1
# Telegram bot username without @ — viral links https://t.me/<BOT>?startapp=p_<id>_r_<tgId>:
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourKianBot


# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 5 — P4: NON-CUSTODIAL TREASURY & MULTI-CHAIN RAILS]
#  Public deposit addresses only — zero private keys on the server.
#  Empty = that chain comes back null in the GET /wallet/treasury response.
# ═══════════════════════════════════════════════════════════════════════════

# TON deposit treasury address — mini-app deposits are minted to this address:
KIAN_TON_TREASURY=
# Article 3 mint rate — default 1000 Đ/TON and 1000 Đ/USDT (empty = default):
KIAN_TON_TO_DIN=1000
KIAN_USDT_TO_DIN=1000
# Per-chain treasury — USDT on TRON (TRC-20) / Solana (SPL) / TON Jetton / BSC (BEP-20):
KIAN_TREASURY_TRX=
KIAN_TREASURY_SOL=
KIAN_TREASURY_TON=
KIAN_TREASURY_BSC=
# HITL parliament quorum — minimum votes for approval. Default 3:
KIAN_NATION_QUORUM=3


# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 6 — P5: RUNTIME GOVERNANCE, TELEMETRY & FRONTEND BUILD VARS]
#  All optional with production-safe defaults. NEXT_PUBLIC_* is read at BUILD
#  time — a redeploy is required after every change.
# ═══════════════════════════════════════════════════════════════════════════

# Bearer session lifetime in hours — default 168 (7 days):
KIAN_SESSION_TTL_HOURS=168

# Request cap per 60-second window per bucket — default 120.
# Tested capacity up to 1,500 concurrent users; this default is right to start with.
KIAN_RATE_LIMIT=120

# Tracing log filter — default info:
RUST_LOG=info

# Railpack build variable (not runtime) — deterministic deploy-binary selection from the workspace.
# The root code guarantees this (crates/server holds direct values); this variable
# is a belt-and-braces guard: if the other crates ever become direct too, the choice must not change.
RAILPACK_CARGO_WORKSPACE=kian-server

# ── apps/web service ──
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_KIAN_URL=

# ── apps/admin service ──
NEXT_PUBLIC_KERNEL_URL=


# ═══════════════════════════════════════════════════════════════════════════
#  Post-deployment checklist
# ═══════════════════════════════════════════════════════════════════════════
#  □ Volume attached at /data (otherwise data is lost on every deploy)
#  □ Service public port = KIAN_PORT (8088 or ${{PORT}})
#  □ curl https://<domain>/api/v1/health → 200
#  □ setWebhook called with secret_token=KIAN_BOT_WEBHOOK_SECRET
#  □ KIAN_CORS_ORIGIN contains the real web/miniapp domains
#  □ /ai/status shows the active slots
#  □ Both P1 secrets (ADMIN_KEY and WEBHOOK_SECRET) generated with openssl rand
# ═══════════════════════════════════════════════════════════════════════════

# ── Cognitive studio and portfolio storefront (Wave 5) — all optional ──
# Default cognitive morph tier: auto (inferred from telemetry) | ToySpark | CreatorStudio | ProTerminal
KIAN_STUDIO_DEFAULT_TIER=auto
# Studio artifact byte cap — empty = default 256 KB (aligned with .env.example):
KIAN_STUDIO_MAX_ARTIFACT_BYTES=
# Portfolio storefront catalog path — Fix #1 remedy (zero parent traversal):
KIAN_PORTFOLIO_CATALOG_PATH=
# ToySpark one-click star default price — default 50 (aligned with .env.example):
KIAN_STUDIO_STOREFRONT_DEFAULT_XTR=50

# ── Causal quant engine and ccxt core (Wave 6) — all optional ──
# Default candle count of the deterministic market generator for the quant DAG (120 to 4000):
KIAN_QUANT_DEFAULT_BARS=720
# Default deterministic seed — same prompt and seed, same strategy and same report:
KIAN_QUANT_DEFAULT_SEED=2026
# List cap for GET /quant/strategies:
KIAN_QUANT_MAX_LIST=100

# ── Sovereign monopoly: pentamodel genome, day-one charter and Base treasury (Wave 7) ──
# All optional — canonical values are locked inside the code; these only tune wiring and paths.
# OMNI-MODEL-GENOME root of the genome matrix (45-file router verification in GET /monopoly/genome-matrix):
KIAN_GENOME_ROOT_PATH=           # empty = ./OMNI-MODEL-GENOME (relative to the workspace root)
# List cap for the persistent allocations of the sovereign treasury:
KIAN_MONOPOLY_MAX_LIST=100
# On-chain settlement chain — only Base Mainnet is the hard contract of Wave 7 (Chain ID 8453):
# RPC: https://mainnet.base.org · Explorer: https://basescan.org
# USDC (native): 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
