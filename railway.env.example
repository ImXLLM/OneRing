# ═══════════════════════════════════════════════════════════════════════════
#  KIAN v2 — Railway Environment (P0 → P5, strictly priority-ordered)
#  این فایل را در Railway → Variables → Raw Editor کپی کنید.
#  Copy this file into Railway → Variables → Raw Editor. Order = operational
#  priority: هرچه مهم‌تر، بالاتر — از بوتِ بحرانی تا تیونینگِ اختیاری.
#
#  پوشش: همهٔ متغیرهای ران‌تایم که کد واقعاً می‌خواند (config.rs · gateway.rs ·
#  opencode_zen.rs · start-railway.sh · اپ‌های Next.js) + ۱ متغیر بیلد Railpack.
#  هیچ متغیر دیگری لازم نیست.
# ═══════════════════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 1 — P0: CRITICAL BOOT, NETWORK & PERSISTENT STORAGE]
#  بحرانی‌ترین — بدون این‌ها سرویس بالا نمی‌آید یا دیتای ملی می‌پرد.
# ═══════════════════════════════════════════════════════════════════════════

# دیتابیس SQLite — داخل حجم دائمی:
#  ۱) در Railway یک Volume به مسیر /data وصل کنید
#  ۲) مسیر زیر دقیقاً داخل همان حجم باشد
# WAL خودکار فعال می‌شود؛ چند اینستنس روی یک فایل اشتراکی ممنوع (یک اینستنس).
KIAN_DATABASE_URL=/data/kian.sqlite

# bind host — روی Railway حتماً 0.0.0.0 (پیش‌فرض 127.0.0.1 فقط لوکال؛
# بدون این مقدار healthcheck Railway هرگز پاس نمی‌شود).
KIAN_HOST=0.0.0.0

# پورت bind — پورت عمومی سرویس را روی همین بگذارید یا به پورت خود Railway ببندید:
KIAN_PORT=${{PORT}}

# منبع seed در بوتِ اول — اگر فایل دیتابیس نبود کپی می‌شود؛ بعد از آن دست‌نخورده
# (ایدمپوتنت؛ start-railway.sh).
KIAN_SEED_DATABASE_PATH=/app/seed/kian-production.db

# بکاپ‌های VACUUM INTO — داخل همان Volume دیتابیس:
KIAN_BACKUP_DIR=/data/backups
KIAN_KEEP_BACKUPS=7


# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 2 — P1: SOVEREIGN SECURITY, AUTH & ADMIN GATES (FAIL-CLOSED)]
#  هر متغیرِ خالی یعنی همان سطح صادقانه «غیرفعال»، نه ناامن.
# ═══════════════════════════════════════════════════════════════════════════

# کلید ادمین (حداقل ۱۶ کاراکتر) — پنل عملیات و مسیرهای /admin. رندم قوی:
#   openssl rand -hex 24
KIAN_ADMIN_KEY=replace-with-32-char-sovereign-admin-key-min16

# اعتماد به X-Forwarded-For — پشت Railway/proxy: true (پیش‌فرض).
# استقرار مستقیم بدون پروکسی → false تا هدر جعلی سقف نرخ را دور نزند.
KIAN_TRUST_PROXY=true

# اوریجین‌های مجاز CORS (کاما جدا) — دامنه‌های واقعی web/miniapp را بگذارید:
KIAN_CORS_ORIGIN=https://<your-web>.up.railway.app,https://<your-miniapp>.up.railway.app,https://web.telegram.org

# D1 (بازرسی فارنزیک #27) — کاملاً fail-closed: فقط "1"/"true"/"yes" روشن می‌کند؛
# غیاب پرچم یا هر مقدار دیگر حتی بدون توکن بات همیشه خاموش است. در تولید 0:
KIAN_DEV_MODE=0


# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 3 — P2: AI INFERENCE MESH — ZERO-COST KEYLESS FIRST, SLOTS NEXT]
#  لاین داخلی OpenCode Zen (Bearer public) بی‌کلید و بدون کارت کار می‌کند؛
#  اسلات‌های زیر اختیاری‌اند. خالی بودن همه = گیت‌وی صادقانه «disabled»
#  (سرور سالم می‌ماند). فقط URL+KEY+MODEL کامل یک اسلات = فعال.
# ═══════════════════════════════════════════════════════════════════════════

# کلید اختصاصی OpenCode (اختیاری — پیش‌فرض بی‌کلید: Bearer public):
OPENCODE_API_KEY=

# میان‌بر تک‌گیت‌وی (روترهای چندمدلی مثل ۹روتر):
KIAN_AI_BASE_URL=
KIAN_AI_API_KEY=
KIAN_AI_MODEL=
KIAN_AI_FALLBACK_MODEL=
KIAN_AI_FALLBACK_URL=
KIAN_AI_FALLBACK_KEY=

# اسلات اول (اصلی) — e.g. https://openrouter.ai/api/v1
KIAN_AI_PRIMARY_URL=
KIAN_AI_PRIMARY_KEY=
KIAN_AI_PRIMARY_MODEL=

# فال‌بک ۱ — با ازکارافتادن primary خودکار جایگزین می‌شود:
KIAN_AI_SECONDARY_URL=
KIAN_AI_SECONDARY_KEY=
KIAN_AI_SECONDARY_MODEL=

# فال‌بک ۲ (اختیاری):
KIAN_AI_TERTIARY_URL=
KIAN_AI_TERTIARY_KEY=
KIAN_AI_TERTIARY_MODEL=

# تامین‌کننده‌های سبک ShopifyHermes (اختیاری؛ ترتیب: coarena ← openrouter ← router9):
KIAN_AI_COARENA_URL=
KIAN_AI_COARENA_KEY=
KIAN_AI_COARENA_KEYS=
KIAN_AI_COARENA_MODELS=
KIAN_AI_OPENROUTER_URL=
KIAN_AI_OPENROUTER_KEY=
KIAN_AI_OPENROUTER_KEYS=
KIAN_AI_OPENROUTER_MODELS=
KIAN_AI_ROUTER9_URL=
KIAN_AI_ROUTER9_KEY=
KIAN_AI_ROUTER9_KEYS=
KIAN_AI_ROUTER9_MODELS=

# سقف روزانهٔ توکن کل استخر — پیش‌فرض ۵۰٬۰۰۰:
KIAN_AI_DAILY_TOKENS=50000


# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 4 — P3: TELEGRAM BOT & MINI-APP (TMA) BRIDGE]
#  توکن بات = مبنای HMAC احراز initData؛ fail-closed: خالی = کل اکوسیستم قفل.
# ═══════════════════════════════════════════════════════════════════════════

# توکن بات تلگرام — از @BotFather بگیرید. هرگز لاگ یا روی سیم نمی‌رود.
KIAN_BOT_TOKEN=

# راز وبهوک رسمی تلگرام (حداقل ۱۶ کاراکتر) — هدر X-Telegram-Bot-Api-Secret-Token.
# fail-closed: خالی بماند، وبهوک بات خاموش است. رندم قوی:
#   openssl rand -hex 16
# بعد از دیپلوی با همین مقدار setWebhook را صدا بزنید (README → Telegram webhook).
KIAN_BOT_WEBHOOK_SECRET=

# دکمهٔ «ورود به مینی‌اپ» در پاسخ‌های بات — دامنهٔ واقعی مینی‌اپ:
KIAN_MINIAPP_URL=https://t.me/ZeroXmain_Bot

# فقط اگر شِل طول‌کشی (kian-bot) را به‌عنوان سرویسِ دومِ جدا دیپلوی می‌کنید:
# آدرس داخلی سرویس کرنل — Railway internal DNS. وگرنه خالی بگذارید.
KIAN_KERNEL_URL=

# ── متغیرهای build-time فرانتاند ──
# پایهٔ API کرنل برای کلاینت مینی‌اپ — دامنهٔ عمومی سرویس kian-server همراه /api/v1:
NEXT_PUBLIC_KIAN_API=https://<your-kernel>.up.railway.app/api/v1
# یوزرنیم بات تلگرام بدون @ — لینک‌های وایرال https://t.me/<BOT>?startapp=p_<id>_r_<tgId>:
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourKianBot


# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 5 — P4: NON-CUSTODIAL TREASURY & MULTI-CHAIN RAILS]
#  فقط آدرس‌های عمومی برای واریز — صفر کلید خصوصی روی سرور.
#  خالی = آن زنجیره در پاسخ GET /wallet/treasury باطل (null) می‌آید.
# ═══════════════════════════════════════════════════════════════════════════

# آدرس خزانهٔ واریز TON — واریزهای مینی‌اپ به این آدرس ضرب می‌شود:
KIAN_TON_TREASURY=
# نرخ ضرب مادهٔ ۳ — پیش‌فرض ۱۰۰۰ Đ/TON و ۱۰۰۰ Đ/USDT (خالی = پیش‌فرض):
KIAN_TON_TO_DIN=1000
KIAN_USDT_TO_DIN=1000
# خزانهٔ هر زنجیره — USDT روی TRON (TRC-20) / Solana (SPL) / TON Jetton / BSC (BEP-20):
KIAN_TREASURY_TRX=
KIAN_TREASURY_SOL=
KIAN_TREASURY_TON=
KIAN_TREASURY_BSC=
# نصاب پارلمان HITL — حداقل رأی برای تصویب. پیش‌فرض ۳:
KIAN_NATION_QUORUM=3


# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 6 — P5: RUNTIME GOVERNANCE, TELEMETRY & FRONTEND BUILD VARS]
#  همه اختیاری با پیش‌فرض‌های تولیدِ امن. NEXT_PUBLIC_* در زمان BUILD خوانده
#  می‌شوند — بعد از هر تغییر redeploy لازم است.
# ═══════════════════════════════════════════════════════════════════════════

# عمر نشست bearer به ساعت — پیش‌فرض ۱۶۸ (۷ روز):
KIAN_SESSION_TTL_HOURS=168

# سقف درخواست در پنجرهٔ ۶۰ثانیه‌ای هر باکت — پیش‌فرض ۱۲۰.
# ظرفیت تست‌شده تا ۱٬۵۰۰ کاربر هم‌زمان؛ برای شروع همین پیش‌فرض درست است.
KIAN_RATE_LIMIT=120

# فیلتر لاگ tracing — پیش‌فرض info:
RUST_LOG=info

# متغیر بیلد Railpack (نه ران‌تایم) — انتخاب قطعی باینری دیپلوی از ورک‌اسپیس.
# کدِ ریشه همین را تضمین می‌کند (crates/server مقدارهای مستقیم دارد)؛ این متغیر
# حکم کمربند و بند است: اگر روزی بقیهٔ کرت‌ها هم مستقیم شدند، انتخاب عوض نشود.
RAILPACK_CARGO_WORKSPACE=kian-server

# ── سرویس apps/web ──
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_KIAN_URL=

# ── سرویس apps/admin ──
NEXT_PUBLIC_KERNEL_URL=


# ═══════════════════════════════════════════════════════════════════════════
#  چک‌لیست بعد از دیپلوی
# ═══════════════════════════════════════════════════════════════════════════
#  □ Volume روی /data وصل شده (وگرنه دیتا با هر دیپلوی می‌پرد)
#  □ پورت عمومی سرویس = KIAN_PORT (۸۰۸۸ یا ${{PORT}})
#  □ curl https://<دامنه>/api/v1/health → 200
#  □ setWebhook با secret_token=KIAN_BOT_WEBHOOK_SECRET صدا زده شد
#  □ KIAN_CORS_ORIGIN دامنه‌های واقعی web/miniapp را دارد
#  □ /ai/status اسلات‌های فعال را نشان می‌دهد
#  □ دو راز P1 (ADMIN_KEY و WEBHOOK_SECRET) با openssl rand ساخته شده‌اند
# ═══════════════════════════════════════════════════════════════════════════

# ── استودیوی ادراک‌سیار و ویترین پورتفولیو (Wave 5) — همه اختیاری ──
# لایهٔ پیش‌فرض مورف شناختی: auto (استنتاج از تلمتری) | ToySpark | CreatorStudio | ProTerminal
KIAN_STUDIO_DEFAULT_TIER=auto
# سقف بایت آرتیفکت استودیو — خالی = پیش‌فرض ۲۵۶ کیلوبایت (هم‌تراز .env.example):
KIAN_STUDIO_MAX_ARTIFACT_BYTES=
# مسیر کاتالوگ ویترین پورتفولیو — درمان Fix #1 (صفر گریز والد):
KIAN_PORTFOLIO_CATALOG_PATH=
# قیمت پیش‌فرض ستارهٔ یک‌کلیکی ToySpark — پیش‌فرض ۵۰ (هم‌تراز .env.example):
KIAN_STUDIO_STOREFRONT_DEFAULT_XTR=50

# ── موتور کوانتِ علّی و هستهٔ ccxt (Wave 6) — همه اختیاری ──
# تعدادِ کندلِ پیش‌فرضِ مولدِ قطعیِ بازار برای DAG کوانت (۱۲۰ تا ۴۰۰۰):
KIAN_QUANT_DEFAULT_BARS=720
# بذرِ قطعیِ پیش‌فرض — همان پرامپت و بذر، همان استراتژی و همان گزارش:
KIAN_QUANT_DEFAULT_SEED=2026
# سقفِ فهرستِ GET /quant/strategies:
KIAN_QUANT_MAX_LIST=100

# ── انحصارِ حاکم: ژنومِ پنتامدلی، منشورِ روزِ اول و خزانهٔ Base (Wave 7) ──
# همه اختیاری — مقادیرِ کانونیک درونِ کد قفل‌اند؛ این‌ها فقط سیم و مسیر را تیون می‌کنند.
# ریشهٔ ماتریسِ ژنوم OMNI-MODEL-GENOME (تأییدِ ۴۵فایلیِ روتر در GET /monopoly/genome-matrix):
KIAN_GENOME_ROOT_PATH=           # خالی = ./OMNI-MODEL-GENOME (نسبت به ریشهٔ ورک‌اسپیس)
# سقفِ فهرستِ تقسیم‌هایِ ماندگارِ خزانهٔ حاکم:
KIAN_MONOPOLY_MAX_LIST=100
# زنجیرهٔ تسویهٔ on-chain — فقط Base Mainnet قراردادِ سختِ Wave 7 است (Chain ID 8453):
# RPC: https://mainnet.base.org · Explorer: https://basescan.org
# USDC بومی: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
