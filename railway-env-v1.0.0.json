  "_notes": {
    "KIAN_BOT_TOKEN": "\u0645\u0628\u0646\u0627\u06cc HMAC \u0627\u062d\u0631\u0627\u0632 initData \u06a9\u0644\u0627\u06cc\u0646\u062a‌\u0647\u0627\u06cc \u062a\u0644\u06af\u0631\u0627\u0645 (crates/server/src/handlers/auth.rs). fail-closed: \u062e\u0627\u0644\u06cc \u0628\u0645\u0627\u0646\u062f \u0647\u06cc\u0686 \u06a9\u0644\u0627\u06cc\u0646\u062a\u06cc \u0627\u062d\u0631\u0627\u0632 \u0646\u0645\u06cc‌\u0634\u0648\u062f \u0648 \u06a9\u0644 \u0627\u06a9\u0648\u0633\u06cc\u0633\u062a\u0645 \u0642\u0641\u0644 \u0627\u0633\u062a. \u0647\u0645\u0686\u0646\u06cc\u0646 \u0628\u0627\u062a (crates/bot) \u0628\u0627 \u0647\u0645\u0627\u0646 \u062a\u0648\u06a9\u0646 \u0628\u0627\u0644\u0627 \u0645\u06cc‌\u0622\u06cc\u062f. \u0647\u0631\u06af\u0632 \u0644\u0627\u06af \u06cc\u0627 \u0631\u0648\u06cc \u0633\u06cc\u0645 \u0646\u0645\u06cc‌\u0631\u0648\u062f.",
    "KIAN_DATABASE_URL": "\u0631\u0648\u06cc Railway \u0628\u0627\u06cc\u062f \u062f\u0627\u062e\u0644 Volume \u0628\u0627\u0634\u062f: \u06f1) Volume \u0628\u0647 \u0645\u0633\u06cc\u0631 /app/data \u0648\u0635\u0644 \u06a9\u0646\u06cc\u062f \u06f2) \u0645\u0633\u06cc\u0631 \u0632\u06cc\u0631 \u062f\u0642\u06cc\u0642\u0627\u064b \u062f\u0627\u062e\u0644 \u0647\u0645\u0627\u0646 \u062d\u062c\u0645 \u0628\u0627\u0634\u062f. WAL \u062e\u0648\u062f\u06a9\u0627\u0631 \u0641\u0639\u0627\u0644 \u0627\u0633\u062a\u061b \u0686\u0646\u062f \u0627\u06cc\u0646\u0633\u062a\u0646\u0633 \u0631\u0648\u06cc \u06cc\u06a9 \u0641\u0627\u06cc\u0644 \u0627\u0634\u062a\u0631\u0627\u06a9\u06cc \u0645\u0645\u0646\u0648\u0639 (\u0641\u0642\u0637 \u06cc\u06a9 \u0627\u06cc\u0646\u0633\u062a\u0646\u0633).",
    "KIAN_HOST": "\u067e\u06cc\u0634‌\u0641\u0631\u0636 \u06a9\u062f 127.0.0.1 \u0627\u0633\u062a \u06a9\u0647 \u0631\u0648\u06cc Railway healthcheck \u0631\u0627 \u0645\u06cc‌\u06a9\u064f\u0634\u062f — \u0631\u0648\u06cc Railway \u062d\u062a\u0645\u0627\u064b 0.0.0.0.",
    "KIAN_PORT": "\u067e\u06cc\u0634‌\u0641\u0631\u0636 8088. \u062f\u0631 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0633\u0631\u0648\u06cc\u0633\u060c \u067e\u0648\u0631\u062a \u0639\u0645\u0648\u0645\u06cc \u0631\u0627 \u0631\u0648\u06cc \u0647\u0645\u06cc\u0646 \u0628\u06af\u0630\u0627\u0631\u06cc\u062f (\u06cc\u0627 KIAN_PORT=${{PORT}} \u0628\u0646\u0648\u06cc\u0633\u06cc\u062f \u062a\u0627 \u067e\u0648\u0631\u062a \u062e\u0648\u062f Railway \u0628\u0633\u062a\u0647 \u0634\u0648\u062f). healthcheck: \u0645\u0633\u06cc\u0631 /health \u0631\u0648\u06cc \u0647\u0645\u06cc\u0646 \u067e\u0648\u0631\u062a.",
    "KIAN_TRUST_PROXY": "\u067e\u0634\u062a Railway/proxy: true (\u067e\u06cc\u0634‌\u0641\u0631\u0636 \u06a9\u062f). \u0627\u06af\u0631 false \u0628\u06af\u0630\u0627\u0631\u06cc\u062f \u0648 \u067e\u0634\u062a \u067e\u0631\u0648\u06a9\u0633\u06cc \u0628\u0627\u0634\u06cc\u062f\u060c \u0647\u062f\u0631 X-Forwarded-For \u062c\u0639\u0644\u06cc \u0633\u0642\u0641 \u0646\u0631\u062e \u0647\u0631 IP \u0631\u0627 \u062f\u0648\u0631 \u0645\u06cc‌\u0632\u0646\u062f — \u0639\u0645\u062f\u0627\u064b false \u0641\u0642\u0637 \u0628\u0631\u0627\u06cc \u0627\u0633\u062a\u0642\u0631\u0627\u0631 \u0645\u0633\u062a\u0642\u06cc\u0645 \u0628\u062f\u0648\u0646 \u067e\u0631\u0648\u06a9\u0633\u06cc.",
    "KIAN_ADMIN_KEY": "\u062d\u062f\u0627\u0642\u0644 \u06f1\u06f6 \u06a9\u0627\u0631\u0627\u06a9\u062a\u0631 — \u0645\u0642\u0627\u06cc\u0633\u0647\u0654 \u0632\u0645\u0627\u0646-\u062b\u0627\u0628\u062a \u0627\u0632 contracts::security. \u0645\u0633\u06cc\u0631\u0647\u0627\u06cc /admin \u0648 \u062f\u0627\u0648\u0631\u06cc HITL. \u062f\u0631 \u062a\u0648\u0644\u06cc\u062f: openssl rand -hex 24.",
    "KIAN_BOT_WEBHOOK_SECRET": "\u0647\u062f\u0631 X-Telegram-Bot-Api-Secret-Token \u0628\u0631\u0627\u06cc POST /bot/webhook. fail-closed: \u062e\u0627\u0644\u06cc \u0628\u0645\u0627\u0646\u062f \u0648\u0628\u0647\u0648\u06a9 \u0628\u0627\u062a \u062e\u0627\u0645\u0648\u0634 \u0627\u0633\u062a. \u0628\u0639\u062f \u0627\u0632 \u062f\u06cc\u067e\u0644\u0648\u06cc \u0628\u0627 \u0647\u0645\u06cc\u0646 \u0645\u0642\u062f\u0627\u0631 setWebhook \u0631\u0627 \u0635\u062f\u0627 \u0628\u0632\u0646\u06cc\u062f (README → Telegram webhook).",
    "KIAN_MINIAPP_URL": "\u062f\u06a9\u0645\u0647\u0654 «\u0648\u0631\u0648\u062f \u0628\u0647 \u0645\u06cc\u0646\u06cc‌\u0627\u067e» \u062f\u0631 \u067e\u0627\u0633\u062e‌\u0647\u0627\u06cc \u0628\u0627\u062a. \u067e\u06cc\u0634‌\u0641\u0631\u0636 \u06a9\u062f localhost:3000 \u0627\u0633\u062a \u06a9\u0647 \u0631\u0648\u06cc Railway \u0628\u06cc‌\u0645\u0639\u0646\u06cc \u0627\u0633\u062a — \u062d\u062a\u0645\u0627\u064b \u0633\u062a \u06a9\u0646\u06cc\u062f.",
    "KIAN_TON_TREASURY": "\u0622\u062f\u0631\u0633 \u062e\u0632\u0627\u0646\u0647\u0654 \u0648\u0627\u0631\u06cc\u0632 TON — \u0648\u0627\u0631\u06cc\u0632\u0647\u0627\u06cc \u0645\u06cc\u0646\u06cc‌\u0627\u067e \u0628\u0647 \u0627\u06cc\u0646 \u0622\u062f\u0631\u0633 \u0636\u0631\u0628 \u0645\u06cc‌\u0634\u0648\u062f (\u0645\u0627\u062f\u0647\u0654 \u06f3). \u062e\u0627\u0644\u06cc = \u0645\u0633\u06cc\u0631 \u0636\u0631\u0628 \u062e\u0648\u062f\u06a9\u0627\u0631 \u063a\u06cc\u0631\u0641\u0639\u0627\u0644.",
    "KIAN_TON_TO_DIN": "\u0646\u0631\u062e \u0636\u0631\u0628 \u0645\u0627\u062f\u0647\u0654 \u06f3 — \u067e\u06cc\u0634‌\u0641\u0631\u0636 \u06f1\u06f0\u06f0\u06f0 Đ/TON.",
    "KIAN_USDT_TO_DIN": "\u0646\u0631\u062e \u0636\u0631\u0628 \u0627\u0632 USDT — \u067e\u06cc\u0634‌\u0641\u0631\u0636 \u06f1\u06f0\u06f0\u06f0 Đ/USDT.",
    "KIAN_TREASURY_TON": "\u0622\u062f\u0631\u0633 \u062e\u0632\u0627\u0646\u0647\u0654 TON \u0628\u0631\u0627\u06cc \u0634\u0641\u0627\u0641\u06cc\u062a \u062e\u0632\u0627\u0646\u0647 (GET /wallet/treasury). \u062e\u0627\u0644\u06cc = \u0622\u0646 \u0632\u0646\u062c\u06cc\u0631\u0647 \u062f\u0631 \u067e\u0646\u0644 \u0634\u0641\u0627\u0641\u06cc\u062a \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0646\u0645\u06cc‌\u0634\u0648\u062f.",
    "KIAN_TREASURY_BSC": "\u0622\u062f\u0631\u0633 \u062e\u0632\u0627\u0646\u0647\u0654 BSC \u0628\u0631\u0627\u06cc \u0634\u0641\u0627\u0641\u06cc\u062a \u062e\u0632\u0627\u0646\u0647 — \u0647\u0645\u0627\u0646 \u0642\u0631\u0627\u0631\u062f\u0627\u062f \u0686\u0647\u0627\u0631\u0632\u0646\u062c\u06cc\u0631\u0647.",
    "KIAN_TREASURY_SOL": "\u0622\u062f\u0631\u0633 \u062e\u0632\u0627\u0646\u0647\u0654 Solana \u0628\u0631\u0627\u06cc \u0634\u0641\u0627\u0641\u06cc\u062a \u062e\u0632\u0627\u0646\u0647 — \u0647\u0645\u0627\u0646 \u0642\u0631\u0627\u0631\u062f\u0627\u062f \u0686\u0647\u0627\u0631\u0632\u0646\u062c\u06cc\u0631\u0647.",
    "KIAN_TREASURY_TRX": "\u0622\u062f\u0631\u0633 \u062e\u0632\u0627\u0646\u0647\u0654 TRON \u0628\u0631\u0627\u06cc \u0634\u0641\u0627\u0641\u06cc\u062a \u062e\u0632\u0627\u0646\u0647 — \u0647\u0645\u0627\u0646 \u0642\u0631\u0627\u0631\u062f\u0627\u062f \u0686\u0647\u0627\u0631\u0632\u0646\u062c\u06cc\u0631\u0647.",
    "KIAN_NATION_QUORUM": "\u0646\u0635\u0627\u0628 \u067e\u0627\u0631\u0644\u0645\u0627\u0646 \u0645\u0644\u06cc (\u062a\u0635\u0645\u06cc\u0645‌\u0647\u0627\u06cc REA). \u067e\u06cc\u0634‌\u0641\u0631\u0636 \u06f3.",
    "KIAN_AI_PRIMARY_URL": "endpoint \u0633\u0627\u0632\u06af\u0627\u0631 OpenAI (chat/completions) \u0627\u0633\u0644\u0627\u062a \u0627\u0648\u0644 — \u0645\u062b\u0627\u0644: https://generativelanguage.googleapis.com/v1beta/openai",
    "KIAN_AI_PRIMARY_KEY": "\u06a9\u0644\u06cc\u062f \u0627\u0633\u0644\u0627\u062a \u0627\u0648\u0644. \u06af\u06cc\u062a‌\u0648\u06cc \u0633\u0647‌\u0627\u0633\u0644\u0627\u062a\u0647 \u0628\u0627 \u0641\u0627\u0644‌\u0628\u06a9 \u0632\u0646\u062c\u06cc\u0631\u0647‌\u0627\u06cc primary→secondary→tertiary (crates/ai/src/gateway.rs). \u062d\u062f\u0627\u0642\u0644 \u0627\u0633\u0644\u0627\u062a \u0627\u0648\u0644 \u0631\u0627 \u067e\u0631 \u06a9\u0646\u06cc\u062f\u061b \u0627\u0633\u0644\u0627\u062a \u062e\u0627\u0644\u06cc = \u062e\u0627\u0645\u0648\u0634 (fail-closed).",
    "KIAN_AI_PRIMARY_MODEL": "\u0627\u0633\u0645 \u0645\u062f\u0644 \u0627\u0633\u0644\u0627\u062a \u0627\u0648\u0644. \u0686\u0648\u0646 base \u0631\u0627 Gemini \u06af\u0630\u0627\u0634\u062a\u0647‌\u0627\u06cc\u062f\u060c \u0628\u0627\u06cc\u062f \u0627\u0633\u0645 \u0645\u062f\u0644 Gemini \u0628\u0627\u0634\u062f (gemini-2.0-flash ✓).",
    "KIAN_AI_SECONDARY_URL": "endpoint \u0627\u0633\u0644\u0627\u062a \u062f\u0648\u0645 — \u0628\u0639\u062f \u0627\u0632 \u062e\u0637\u0627/\u062a\u062e\u0644\u06cc\u0647\u0654 \u0627\u0648\u0644 \u0635\u062f\u0627 \u0645\u06cc‌\u0634\u0648\u062f. \u0645\u062a\u0646 \u062e\u0627\u0645 \u062e\u0637\u0627\u06cc \u0622\u067e‌\u0627\u0633\u062a\u0631\u06cc\u0645 \u0647\u0631\u06af\u0632 \u0628\u0627\u0644\u0627 \u0646\u0645\u06cc‌\u0622\u06cc\u062f (AttemptFailure \u0641\u0642\u0637 \u0646\u0627\u0645 \u0627\u0633\u0644\u0627\u062a + \u062c\u0632\u0626\u06cc\u0627\u062a \u06a9\u0648\u062a\u0627\u0647).",
    "KIAN_AI_SECONDARY_KEY": "\u06a9\u0644\u06cc\u062f \u0627\u0633\u0644\u0627\u062a \u062f\u0648\u0645.",
    "KIAN_AI_SECONDARY_MODEL": "\u0627\u0633\u0645 \u0645\u062f\u0644 \u0627\u0633\u0644\u0627\u062a \u062f\u0648\u0645.",
    "KIAN_AI_TERTIARY_URL": "endpoint \u0627\u0633\u0644\u0627\u062a \u0633\u0648\u0645 — \u0622\u062e\u0631\u06cc\u0646 \u0641\u0627\u0644‌\u0628\u06a9 \u0642\u0628\u0644 \u0627\u0632 \u067e\u0627\u0633\u062e «\u0647\u0645\u0647‌\u062c\u0627 \u0634\u06a9\u0633\u062a».",
    "KIAN_AI_TERTIARY_KEY": "\u06a9\u0644\u06cc\u062f \u0627\u0633\u0644\u0627\u062a \u0633\u0648\u0645.",
    "KIAN_AI_TERTIARY_MODEL": "\u0627\u0633\u0645 \u0645\u062f\u0644 \u0627\u0633\u0644\u0627\u062a \u0633\u0648\u0645.",
    "KIAN_AI_DAILY_TOKENS": "\u0633\u0642\u0641 \u0631\u0648\u0632\u0627\u0646\u0647\u0654 \u062a\u0648\u06a9\u0646 \u0647\u0631 \u06a9\u0627\u0631\u0628\u0631 — \u067e\u06cc\u0634‌\u0641\u0631\u0636 \u06f5\u06f0\u066c\u06f0\u06f0\u06f0. \u0642\u0628\u0644 \u0627\u0632 \u0627\u0631\u0633\u0627\u0644 \u0628\u0647 \u0627\u0633\u0644\u0627\u062a\u060c redaction \u0627\u0646\u062c\u0627\u0645 \u0645\u06cc‌\u0634\u0648\u062f.",
    "KIAN_CORS_ORIGIN": "\u067e\u06cc\u0634‌\u0641\u0631\u0636 \u06a9\u062f \u0641\u0642\u0637 localhost:3000 \u0627\u0633\u062a — \u0631\u0648\u06cc Railway \u062d\u062a\u0645\u0627\u064b \u062f\u0627\u0645\u0646\u0647‌\u0647\u0627\u06cc \u0648\u0627\u0642\u0639\u06cc \u0645\u06cc\u0646\u06cc‌\u0627\u067e/\u0648\u0628 \u0631\u0627 \u0628\u0627 \u06a9\u0627\u0645\u0627 \u0628\u062f\u0647\u06cc\u062f \u0648\u06af\u0631\u0646\u0647 \u0641\u0631\u0627\u0646\u062a \u0627\u0632 \u0645\u0631\u0648\u0631\u06af\u0631 \u0628\u0644\u0627\u06a9 \u0645\u06cc‌\u0634\u0648\u062f (tower-http CORS).",
    "KIAN_SESSION_TTL_HOURS": "\u0639\u0645\u0631 \u0646\u0634\u0633\u062a — \u067e\u06cc\u0634‌\u0641\u0631\u0636 \u06f1\u06f6\u06f8 \u0633\u0627\u0639\u062a (\u06cc\u06a9 \u0647\u0641\u062a\u0647).",
    "KIAN_RATE_LIMIT": "\u0633\u0642\u0641 \u0646\u0631\u062e per-IP \u0628\u0627 \u06f1\u06f6 \u0634\u0627\u0631\u062f FNV-1a — \u067e\u06cc\u0634‌\u0641\u0631\u0636 \u06f1\u06f2\u06f0 \u062f\u0631\u062e\u0648\u0627\u0633\u062a/\u062f\u0642\u06cc\u0642\u0647. \u0628\u0627 KIAN_TRUST_PROXY=true\u060c IP \u0648\u0627\u0642\u0639\u06cc \u0627\u0632 X-Forwarded-For \u062e\u0648\u0627\u0646\u062f\u0647 \u0645\u06cc‌\u0634\u0648\u062f.",
    "KIAN_BACKUP_DIR": "\u067e\u06cc\u0634‌\u0641\u0631\u0636 data/backups — \u0631\u0648\u06cc Volume \u0646\u06af\u0647\u0634 \u062f\u0627\u0631\u06cc\u062f: /app/data/backups \u0648\u06af\u0631\u0646\u0647 \u0628\u06a9\u0627\u067e‌\u0647\u0627 \u0628\u0627 \u0647\u0631 deploy \u067e\u0631 \u0645\u06cc‌\u0634\u0648\u0646\u062f.",
    "KIAN_KEEP_BACKUPS": "\u062a\u0639\u062f\u0627\u062f \u0628\u06a9\u0627\u067e‌\u0647\u0627\u06cc \u0646\u06af\u0647‌\u062f\u0627\u0634\u062a\u0647‌\u0634\u062f\u0647 — \u067e\u06cc\u0634‌\u0641\u0631\u0636 \u06f7.",
    "KIAN_KERNEL_URL": "\u0622\u062f\u0631\u0633 \u06a9\u0631\u0646\u0644 \u0627\u0632 \u062f\u06cc\u062f \u0628\u0627\u062a (crates/bot/src/main.rs:30) — \u067e\u06cc\u0634‌\u0641\u0631\u0636 http://127.0.0.1:8088. \u0627\u06af\u0631 \u0628\u0627\u062a \u0631\u0627 \u0628\u0647‌\u0639\u0646\u0648\u0627\u0646 \u0633\u0631\u0648\u06cc\u0633 \u062c\u062f\u0627 \u062f\u0631 Railway \u0628\u0627\u0644\u0627 \u0645\u06cc‌\u0628\u0631\u06cc\u062f\u060c \u0627\u0632 \u062f\u0627\u0645\u0646\u0647\u0654 \u062f\u0627\u062e\u0644\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f: http://<\u0646\u0627\u0645-\u0633\u0631\u0648\u06cc\u0633-\u06a9\u0631\u0646\u0644>.railway.internal:8088. \u0627\u06af\u0631 \u0628\u0627\u062a \u0648 \u06a9\u0631\u0646\u0644 \u06cc\u06a9 \u0633\u0631\u0648\u06cc\u0633‌\u0627\u0646\u062f\u060c \u0647\u0645\u06cc\u0646 \u067e\u06cc\u0634‌\u0641\u0631\u0636 \u062f\u0631\u0633\u062a \u0627\u0633\u062a.",
    "RUST_LOG": "\u0641\u06cc\u0644\u062a\u0631 \u0644\u0627\u06af tracing — \u062e\u0648\u0627\u0646\u062f\u0647‌\u0634\u062f\u0647 \u0628\u0627 try_from_default_env \u062f\u0631 \u0647\u0631 \u062f\u0648 \u0628\u0627\u06cc\u0646\u0631\u06cc. \u067e\u06cc\u0634‌\u0641\u0631\u0636 info (\u0628\u0627\u062a: info,teloxide=warn). \u0645\u062b\u0627\u0644: KIAN_SERVER \u0641\u0642\u0637 \u062f\u06cc\u0628\u0627\u06af \u06a9\u0631\u0646\u0644: kian_server=debug,info",
    "NEXT_PUBLIC_SITE_URL": "\u062f\u0631 \u0632\u0645\u0627\u0646 **\u0628\u06cc\u0644\u062f** \u062e\u0648\u0627\u0646\u062f\u0647 \u0645\u06cc‌\u0634\u0648\u062f (apps/web/app/layout.tsx — \u0645\u062a\u0627/\u06a9\u0627\u0646\u0646\u06cc\u06a9\u0627\u0644) — \u0628\u0639\u062f \u0627\u0632 \u062a\u063a\u06cc\u06cc\u0631 redeploy \u0644\u0627\u0632\u0645 \u0627\u0633\u062a.",
    "NEXT_PUBLIC_KIAN_URL": "\u062f\u0631 \u0632\u0645\u0627\u0646 **\u0628\u06cc\u0644\u062f** \u062e\u0648\u0627\u0646\u062f\u0647 \u0645\u06cc‌\u0634\u0648\u062f (TonConnect \u062f\u0631 apps/web \u0648 apps/miniapp) — \u0628\u0639\u062f \u0627\u0632 \u062a\u063a\u06cc\u06cc\u0631 redeploy \u0644\u0627\u0632\u0645 \u0627\u0633\u062a.",
    "NEXT_PUBLIC_KIAN_API": "\u062f\u0631 \u0632\u0645\u0627\u0646 **\u0628\u06cc\u0644\u062f** \u062e\u0648\u0627\u0646\u062f\u0647 \u0645\u06cc‌\u0634\u0648\u062f (apps/web/lib/api.ts + packages/sdk/src/index.ts) — \u0622\u062f\u0631\u0633 API \u06a9\u0631\u0646\u0644 \u0628\u0631\u0627\u06cc \u0648\u0628 \u0648 SDK.",
    "NEXT_PUBLIC_KERNEL_URL": "\u062f\u0631 \u0632\u0645\u0627\u0646 **\u0628\u06cc\u0644\u062f** \u062e\u0648\u0627\u0646\u062f\u0647 \u0645\u06cc‌\u0634\u0648\u062f (apps/admin/lib/admin-api.ts) — \u0622\u062f\u0631\u0633 \u06a9\u0631\u0646\u0644 \u0628\u0631\u0627\u06cc \u067e\u0646\u0644 \u0627\u062f\u0645\u06cc\u0646. \u0647\u0631 \u0627\u067e (web/admin/miniapp) \u0633\u0631\u0648\u06cc\u0633 \u062c\u062f\u0627 \u062f\u0631 Railway \u0628\u0627 \u0645\u062a\u063a\u06cc\u0631\u0647\u0627\u06cc \u062e\u0648\u062f\u0634 \u0627\u0633\u062a.",
    "RAILPACK_CARGO_WORKSPACE": "\u0645\u062a\u063a\u06cc\u0631 \u0628\u06cc\u0644\u062f Railpack (\u0646\u0647 \u0631\u0627\u0646‌\u062a\u0627\u06cc\u0645) — \u0627\u0646\u062a\u062e\u0627\u0628 \u0642\u0637\u0639\u06cc \u0628\u0627\u06cc\u0646\u0631\u06cc \u062f\u06cc\u067e\u0644\u0648\u06cc \u0627\u0632 \u0648\u0631\u06a9‌\u0627\u0633\u067e\u06cc\u0633. \u0631\u06cc\u0634\u0647\u0654 \u062f\u0627\u0633\u062a\u0627\u0646: Railpack v0.43 \u06a9\u0644\u06cc\u062f\u0647\u0627\u06cc \u0646\u0642\u0637\u0647‌\u062f\u0627\u0631 \u0648\u0631\u0627\u062b\u062a (`*.workspace = true`) \u0631\u0627 parse \u0646\u0645\u06cc‌\u06a9\u0646\u062f\u061b crates/server \u0639\u0645\u062f\u0627\u064b \u0645\u0642\u062f\u0627\u0631\u0647\u0627\u06cc \u0645\u0633\u062a\u0642\u06cc\u0645 \u062f\u0627\u0631\u062f \u062a\u0627 \u0628\u062f\u0648\u0646 \u0627\u06cc\u0646 \u0645\u062a\u063a\u06cc\u0631 \u0647\u0645 \u062f\u0631\u0633\u062a \u0628\u06cc\u0644\u062f \u0634\u0648\u062f\u061b \u0627\u06cc\u0646 \u0645\u062a\u063a\u06cc\u0631 \u062d\u06a9\u0645 \u06a9\u0645\u0631\u0628\u0646\u062f \u0648 \u0628\u0646\u062f \u0627\u0633\u062a. (\u06af\u0648\u0627\u0647: railpack-cli v0.43.0 \u0631\u0648\u06cc \u0647\u0645\u06cc\u0646 \u0631\u06cc\u067e\u0648 — \u0628\u0627 \u0645\u062a\u063a\u06cc\u0631: cargo build --release --package kian-server + cp \u0628\u0647 bin/)",
    "(optional_advanced \u062e\u0627\u0644\u06cc)": "KIAN \u0639\u0645\u062f\u0627\u064b \u0647\u06cc\u0686 \u062a\u06cc\u0648\u0646 \u067e\u0646\u0647\u0627\u0646\u06cc \u0646\u062f\u0627\u0631\u062f — \u0647\u0631 \u06f3\u06f6 \u06a9\u0644\u06cc\u062f \u0647\u0645\u06cc\u0646‌\u0627\u0646\u062f \u0648 \u0647\u0645\u0647 \u062f\u0631 config.rs / gateway.rs / bot \u0628\u0627 \u067e\u06cc\u0634‌\u0641\u0631\u0636 \u0627\u0645\u0646. \u0686\u06cc\u0632\u06cc \u0634\u0628\u06cc\u0647 WEB_RATE_* \u06cc\u0627 MEM_FACET_* \u067e\u0631\u0648\u0698\u0647\u0654 \u0642\u062f\u06cc\u0645\u06cc \u062f\u0631 KIAN \u0646\u06cc\u0633\u062a\u061b \u0647\u0627\u0631\u062f\u0646\u06cc\u0646\u06af (WAL\u060c \u0634\u0627\u0631\u062f \u0646\u0631\u062e‌\u0633\u0646\u062c\u060c redaction\u060c \u0633\u0642\u0641 \u062a\u0648\u06a9\u0646) \u062f\u0631 \u06a9\u062f \u062b\u0627\u0628\u062a \u0627\u0633\u062a.",
    "(never_set_in_production \u062e\u0627\u0644\u06cc)": "\u0628\u0631\u062e\u0644\u0627\u0641 \u067e\u0631\u0648\u0698\u0647\u0654 \u0642\u062f\u06cc\u0645\u06cc (APP_DEV_LOGIN / SANDBOX_ALLOW_LOCAL)\u060c \u062f\u0631 KIAN \u0647\u06cc\u0686 \u062f\u0631\u0650 \u067e\u0634\u062a\u06cc env-\u0645\u062d\u0648\u0631\u06cc \u0648\u062c\u0648\u062f \u0646\u062f\u0627\u0631\u062f. \u062a\u0646\u0647\u0627 «\u062a\u0644\u0647» \u0631\u0641\u062a\u0627\u0631\u06cc: KIAN_ADMIN_KEY \u062e\u0627\u0644\u06cc = \u0627\u062f\u0645\u06cc\u0646 \u062e\u0627\u0645\u0648\u0634 (fail-closed\u060c \u0627\u0645\u0646 \u0648\u0644\u06cc \u0628\u06cc‌\u067e\u0646\u0644)\u061b \u0648 KIAN_TRUST_PROXY=false \u067e\u0634\u062a \u067e\u0631\u0648\u06a9\u0633\u06cc = \u062f\u0648\u0631 \u0632\u062f\u0646 \u0633\u0642\u0641 \u0646\u0631\u062e. \u0647\u06cc\u0686‌\u06a9\u062f\u0627\u0645 \u0645\u062a\u063a\u06cc\u0631 \u0645\u0645\u0646\u0648\u0639\u0647 \u0646\u06cc\u0633\u062a\u0646\u062f\u060c \u0641\u0642\u0637 \u062f\u0631\u0633\u062a \u0633\u062a \u0634\u0648\u0646\u062f.",
    "KIAN_DEV_MODE": "D1 (\u0628\u0627\u0632\u0631\u0633\u06cc \u0641\u0627\u0631\u0646\u0632\u06cc\u06a9 #27) — \u06a9\u0627\u0645\u0644\u0627\u064b fail-closed: \u0641\u0642\u0637 «1»/«true»/«yes» (\u0628\u062f\u0648\u0646 \u062a\u0648\u062c\u0647 \u0628\u0647 \u0628\u0632\u0631\u06af\u06cc/\u06a9\u0648\u0686\u06a9\u06cc) \u0631\u0648\u0634\u0646\u0634 \u0645\u06cc‌\u06a9\u0646\u062f\u061b \u063a\u06cc\u0627\u0628 \u067e\u0631\u0686\u0645 \u06cc\u0627 \u0647\u0631 \u0645\u0642\u062f\u0627\u0631 \u062f\u06cc\u06af\u0631 \u062d\u062a\u06cc \u0628\u062f\u0648\u0646 \u062a\u0648\u06a9\u0646 \u0628\u0627\u062a \u0647\u0645\u06cc\u0634\u0647 \u062e\u0627\u0645\u0648\u0634 \u0627\u0633\u062a. /auth/dev-login \u0648 /wallet/faucet \u0641\u0642\u0637 \u062f\u0631 \u062d\u0627\u0644\u062a dev \u067e\u0627\u0633\u062e \u0645\u06cc‌\u062f\u0647\u0646\u062f — \u062f\u0631 \u062a\u0648\u0644\u06cc\u062f \u0647\u0645\u06cc\u0646 0 \u0628\u0645\u0627\u0646\u062f.",
    "KIAN_SEED_DATABASE_PATH": "\u0645\u0646\u0628\u0639 seed \u062f\u0631 \u0628\u0648\u062a\u0650 \u0627\u0648\u0644 (start-railway.sh\u061b \u0627\u06cc\u062f\u0645\u067e\u0648\u062a\u0646\u062a — \u0628\u0639\u062f \u0627\u0632 \u0628\u0648\u062a \u0627\u0648\u0644 \u062f\u0633\u062a‌\u0646\u062e\u0648\u0631\u062f\u0647). \u0631\u0648\u06cc Railway \u062f\u0627\u062e\u0644 \u0627\u06cc\u0645\u06cc\u062c \u062f\u0631 /app/seed/kian-production.db \u0642\u0631\u0627\u0631 \u062f\u0627\u0631\u062f\u061b \u062f\u06cc\u062a\u0627\u0628\u06cc\u0633 \u0648\u0627\u0642\u0639\u06cc \u0631\u0648\u06cc Volume (KIAN_DATABASE_URL) \u0633\u0627\u062e\u062a\u0647 \u0645\u06cc‌\u0634\u0648\u062f."
  }
}
