# ═══════════════════════════════════════════════════════════════════════════
#  KIAN — Environment Configuration (strictly priority-ordered: P0 → P5)
#  Layout: most important first — from critical boot to optional tuning.
#  Every variable below is actively read by kian-server (config.rs), kian-ai
#  (gateway.rs / opencode_zen.rs), start-railway.sh, or the Next.js apps.
#
#  Local test night: copy this file to .env — the defaults below open the full
#  creator→publish→buy→withdraw cycle without Telegram and without real keys.
#  Never commit real secrets — use Railway Variables / KMS in production.
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 1 — P0: CRITICAL BOOT, NETWORK & PERSISTENT STORAGE]
#  Most critical — without these the server will not boot or sovereign state is lost.
# ═══════════════════════════════════════════════════════════════════════════
KIAN_DATABASE_URL=                # SQLite path/URL — default data/kian.sqlite (automatic WAL); on Railway: file:/data/kian.db inside the attached volume
KIAN_HOST=0.0.0.0                 # bind address — default 127.0.0.1; in Docker/Railway always 0.0.0.0 (the healthcheck depends on it)
KIAN_PORT=8088                    # HTTP port — default 8088; on Railway you can bind KIAN_PORT=${{PORT}}
KIAN_SEED_DATABASE_PATH=/app/seed/kian-production.db  # Seed source on first boot (start-railway.sh; idempotent — untouched after the first boot)
KIAN_BACKUP_DIR=data/backups      # VACUUM INTO backup folder — on Railway: /data/backups (same volume as the database)
KIAN_KEEP_BACKUPS=7               # Number of backups to keep — default 7

# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 2 — P1: SOVEREIGN SECURITY, AUTH & ADMIN GATES (FAIL-CLOSED)]
#  Sovereign security — every empty variable means the honest "disabled" level, not insecure.
# ═══════════════════════════════════════════════════════════════════════════
# Admin key — /admin routes and HITL arbitration. Min 16 chars; in production:
#   openssl rand -hex 24  →  KIAN_ADMIN_KEY=<output>
# (the dev- prefix = local test-night trial key with min 8 chars)
KIAN_ADMIN_KEY=replace-with-32-char-sovereign-admin-key-min16
KIAN_TRUST_PROXY=true             # Trust X-Forwarded-For behind Railway/proxy — direct deployment: false so a forged header cannot bypass the rate cap
KIAN_CORS_ORIGIN=                 # Allowed CORS origins, comma-separated (web/miniapp/admin) — empty = localhost:3000 only
# D1 (forensic audit #27) — fully fail-closed: only "1"/"true"/"yes" (case-
# insensitive) turns it on; a missing flag or any other value, even without
# a bot token, always stays off. Keep this 0 in production:
KIAN_DEV_MODE=0

# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 3 — P2: AI INFERENCE MESH — ZERO-COST KEYLESS FIRST, SLOTS NEXT]
#  AI engine — first priority: free models with no card and no key.
# ═══════════════════════════════════════════════════════════════════════════
# The built-in card-free OpenCode Zen lane is always constructed: keyless Bearer public on
# https://opencode.ai/inference/openai/v1 (10 active models; beam-free with a
# 1,048,576-token window). This variable is only for optionally attaching a dedicated key:
OPENCODE_API_KEY=
#
# Leaving every KIAN_AI_* empty = the gateway honestly reports "disabled" and the studio
# runs on "local fallback synthesis" (server stays healthy — GET /ai/status).
#
# Single-gateway shortcut (multi-model routers such as router9) — these 4 variables suffice:
KIAN_AI_BASE_URL=                 # e.g. https://your-router.up.railway.app/v1
KIAN_AI_API_KEY=                  # Router key — inherited by the primary/fallback slots; comma list allowed
KIAN_AI_MODEL=                    # Primary model(s) — e.g. alicode/glm-5 or m1,m2,m3
KIAN_AI_FALLBACK_MODEL=           # Secondary model(s) on the same router — e.g. oc/deepseek-v4.1-flash-free,oc/glm-5.3-flash-free
# (optional) separate URL/key for the fallback slot:
KIAN_AI_FALLBACK_URL=
KIAN_AI_FALLBACK_KEY=
#
# Fine-grained slot control — takes precedence over the shortcuts above (KEY/MODEL accept comma lists;
# brain.py pool architecture: the cartesian product of "every model × every key" forms one flat fallback
# pool; the last last_good winner is retried first next time; a broken response is rejected by the
# quality gate and the least-harmful available option is rescued — GET /ai/status → poolSize):
KIAN_AI_PRIMARY_URL=              # e.g. https://openrouter.ai/api/v1
KIAN_AI_PRIMARY_KEY=              # e.g. sk-or-v1-... (or k1,k2 for rotation)
KIAN_AI_PRIMARY_MODEL=            # e.g. openrouter/free,baidu/ernie-5.5-flash-preview:free,particle-ai/particle-1:free
KIAN_AI_SECONDARY_URL=            # Fallback slot 2
KIAN_AI_SECONDARY_KEY=
KIAN_AI_SECONDARY_MODEL=          # e.g. oc/deepseek-v4.1-flash-free,oc/glm-5.3-flash-free,oc/longcat-2.5-free
KIAN_AI_TERTIARY_URL=             # Fallback slot 3 — e.g. https://coarena.ai/api/v1 ($5 free daily credit)
KIAN_AI_TERTIARY_KEY=
KIAN_AI_TERTIARY_MODEL=           # e.g. gpt-6-luna,gpt-6-1-sol,gemini-3-8-flash
#
# ShopifyHermes-style providers (optional) — when present they are appended to the end
# of the pool (order: coarena ← openrouter ← router9); ignored without a key:
KIAN_AI_COARENA_URL=              # default https://coarena.ai/api/v1
KIAN_AI_COARENA_KEY=
KIAN_AI_COARENA_KEYS=
KIAN_AI_COARENA_MODELS=           # e.g. gpt-6-luna,gemini-3-8-flash
KIAN_AI_OPENROUTER_URL=           # default https://openrouter.ai/api/v1
KIAN_AI_OPENROUTER_KEY=
KIAN_AI_OPENROUTER_KEYS=
KIAN_AI_OPENROUTER_MODELS=        # e.g. qwen/qwen-2.5-coder-32b-instruct:free,...
KIAN_AI_ROUTER9_URL=
KIAN_AI_ROUTER9_KEY=
KIAN_AI_ROUTER9_KEYS=
KIAN_AI_ROUTER9_MODELS=           # e.g. oc/deepseek-v4.1-flash-free,oc/glm-5.3-flash-free
#
# Daily token cap for the whole pool — default 50,000:
KIAN_AI_DAILY_TOKENS=50000

# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 4 — P3: TELEGRAM BOT & MINI-APP (TMA) BRIDGE]
#  Telegram bridge — TMA HMAC auth, fail-closed webhook and the mini-app button.
# ═══════════════════════════════════════════════════════════════════════════
KIAN_BOT_TOKEN=                   # @BotFather token — HMAC basis for initData auth (fail-closed; never logged or sent over the wire)
KIAN_BOT_WEBHOOK_SECRET=          # Official Telegram webhook secret (≥16 chars) — X-Telegram-Bot-Api-Secret-Token header (fail-closed)
KIAN_MINIAPP_URL=                 # URL of the public mini-app for the bot WebApp button — default localhost:3000
KIAN_KERNEL_URL=http://127.0.0.1:8088  # Kernel URL for the bot polling shell + admin panel (separate deployment only)
NEXT_PUBLIC_KIAN_API=http://127.0.0.1:8088/api/v1  # Kernel API base for the mini-app client (build-time)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=  # Bot username without @ — viral links ?startapp=p_<id>_r_<ref>

# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 5 — P4: NON-CUSTODIAL TREASURY & MULTI-CHAIN RAILS]
#  Non-custodial treasury — public deposit addresses only; zero private keys on the server.
# ═══════════════════════════════════════════════════════════════════════════
KIAN_TON_TREASURY=                # Public TON treasury address — mini-app deposits are minted to this address
KIAN_TON_TO_DIN=1000              # Article 3 mint rate — din per 1 TON — default 1000
KIAN_USDT_TO_DIN=1000             # Mint rate — din per 1 USDT — default 1000
KIAN_TREASURY_TRX=                # Public TRON (TRC-20) treasury — empty = that chain comes back null in GET /wallet/treasury
KIAN_TREASURY_SOL=                # Public Solana (SPL) treasury
KIAN_TREASURY_TON=                # Public Jetton USDT treasury on TON
KIAN_TREASURY_BSC=                # Public BNB Chain (BEP-20) treasury
KIAN_NATION_QUORUM=3              # HITL parliament quorum — default 3

# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 6 — P5: RUNTIME GOVERNANCE, TELEMETRY & FRONTEND BUILD VARS]
#  Advanced tuning — all optional with production-safe defaults.
#  NEXT_PUBLIC_* is read at BUILD time — a redeploy is required after any change.
# ═══════════════════════════════════════════════════════════════════════════
KIAN_SESSION_TTL_HOURS=168        # Bearer session lifetime in hours — default 168 (7 days)
KIAN_RATE_LIMIT=120               # Request cap per 60-second window per bucket — default 120
RUST_LOG=info,kian_server=info,kian_hermes=info,kian_ai=info  # Tracing log filter — default info
RAILPACK_CARGO_WORKSPACE=kian-server  # Railpack build variable — deterministic deploy-binary selection from the workspace
NEXT_PUBLIC_SITE_URL=             # apps/web — public URL of the site itself (build-time)
NEXT_PUBLIC_KIAN_URL=             # apps/web — public kernel URL used in subscriptions (build-time)
NEXT_PUBLIC_KERNEL_URL=http://127.0.0.1:8088  # apps/admin — kernel API base with the X-KIAN-Key header (build-time)
KIAN_STUDIO_DEFAULT_TIER=auto     # Cognitive studio (Wave 5) — auto | ToySpark | CreatorStudio | ProTerminal — default auto (inferred from telemetry)
KIAN_STUDIO_MAX_ARTIFACT_BYTES=   # Studio artifact byte cap — empty = default 256 KB
KIAN_PORTFOLIO_CATALOG_PATH=      # Portfolio storefront (Fix #1) — catalog path; empty = ./seed/portfolio_catalog (zero parent traversal)
KIAN_STUDIO_STOREFRONT_DEFAULT_XTR=50  # ToySpark one-click star default price — default 50

KIAN_QUANT_DEFAULT_BARS=720      # Causal quant engine (Wave 6) — default candle count of the deterministic market generator — default 720
KIAN_QUANT_DEFAULT_SEED=2026     # Default deterministic seed of the quant DAG — default 2026
KIAN_QUANT_MAX_LIST=100          # List cap for persisted strategies in GET /quant/strategies — default 100

# ── Sovereign monopoly: pentamodel genome, day-one charter and Base treasury (Wave 7) ──
# All optional — canonical values are locked inside the code; these only tune wiring and paths.
# OMNI-MODEL-GENOME root of the genome matrix (45-file router verification in GET /monopoly/genome-matrix):
KIAN_GENOME_ROOT_PATH=           # empty = ./OMNI-MODEL-GENOME (relative to the workspace root)
# List cap for the persistent allocations of the sovereign treasury:
KIAN_MONOPOLY_MAX_LIST=100
# On-chain settlement chain — only Base Mainnet is the hard contract of Wave 7 (Chain ID 8453):
# RPC: https://mainnet.base.org · Explorer: https://basescan.org
# USDC (native): 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
