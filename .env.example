# ═══════════════════════════════════════════════════════════════════════════
#  KIAN — Environment Configuration (strictly priority-ordered: P0 → P5)
#  چیدمان: هرچه مهم‌تر، بالاتر — از بوتِ بحرانی تا تیونینگِ اختیاری.
#  Every variable below is actively read by kian-server (config.rs), kian-ai
#  (gateway.rs / opencode_zen.rs), start-railway.sh, or the Next.js apps.
#
#  «شبِ تستِ محلی»: این فایل را به .env کپی کنید — مقادیر پیش‌فرضِ زیر کل
#  چرخهٔ سازنده→انتشار→خرید→برداشت را بدون تلگرام و بدون کلید واقعی باز می‌کند.
#  هرگز راز واقعی کامیت نکنید — در تولید از Railway Variables / KMS استفاده کنید.
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 1 — P0: CRITICAL BOOT, NETWORK & PERSISTENT STORAGE]
#  بحرانی‌ترین — بدون این‌ها سرور بالا نمی‌آید یا وضعیتِ ملی از بین می‌رود.
# ═══════════════════════════════════════════════════════════════════════════
KIAN_DATABASE_URL=                # SQLite مسیر/URL — پیش‌فرض data/kian.sqlite (WAL خودکار)؛ روی Railway: file:/data/kian.db داخل Volume وصل‌شده
KIAN_HOST=0.0.0.0                 # آدرس bind — پیش‌فرض 127.0.0.1؛ در Docker/Railway حتماً 0.0.0.0 (healthcheck به آن وابسته است)
KIAN_PORT=8088                    # پورت HTTP — پیش‌فرض 8088؛ روی Railway می‌توانید KIAN_PORT=${{PORT}} ببندید
KIAN_SEED_DATABASE_PATH=/app/seed/kian-production.db  # منبع seed در بوتِ اول (start-railway.sh؛ ایدمپوتنت — بعد از بوت اول دست‌نخورده)
KIAN_BACKUP_DIR=data/backups      # پوشهٔ بکاپ VACUUM INTO — روی Railway: /data/backups (همان حجم دیتابیس)
KIAN_KEEP_BACKUPS=7               # تعداد بکاپ نگه‌داشتنی — پیش‌فرض ۷

# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 2 — P1: SOVEREIGN SECURITY, AUTH & ADMIN GATES (FAIL-CLOSED)]
#  امنیت حاکم — هر متغیرِ خالی یعنی همان سطح صادقانه «غیرفعال»، نه ناامن.
# ═══════════════════════════════════════════════════════════════════════════
# کلید ادمین — مسیرهای /admin و داوری HITL. حداقل ۱۶ کاراکتر؛ در تولید:
#   openssl rand -hex 24  →  KIAN_ADMIN_KEY=<خروجی>
# (پیشوند dev- = کلید آزمایشیِ شبِ تست با حداقل ۸ کاراکتر)
KIAN_ADMIN_KEY=dev-admin-key
KIAN_TRUST_PROXY=true             # اعتماد به X-Forwarded-For پشت Railway/proxy — استقرار مستقیم: false تا هدر جعلی سقف نرخ را دور نزند
KIAN_CORS_ORIGIN=                 # اوریجین‌های مجاز CORS با ویرگول (مینی‌اپ وب/ادمین) — خالی = فقط localhost:3000
KIAN_DEV_MODE=false               # در تولید false — /auth/dev-login و /wallet/faucet را فعال می‌کند (بدون توکن بات هم خودبه‌خود فعال می‌شود؛ در تولید توکن را ست کنید)

# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 3 — P2: AI INFERENCE MESH — ZERO-COST KEYLESS FIRST, SLOTS NEXT]
#  موتور هوش مصنوعی — اولویت اول: مدل‌های رایگانِ بدون کارت و بدون کلید.
# ═══════════════════════════════════════════════════════════════════════════
# لاینِ داخلیِ صفر-کارت OpenCode Zen همیشه ساخته می‌شود: Bearer public بی‌کلید روی
# https://opencode.ai/inference/openai/v1 (۱۰ مدل فعال؛ beam-free با پنجرهٔ
# ۱٬۰۴۸٬۵۷۶ توکن). این متغیر فقط برای سوارکردن کلید اختصاصی اختیاری است:
OPENCODE_API_KEY=
#
# خالی گذاشتنِ همهٔ KIAN_AI_* = گیت‌وی صادقانه «disabled» گزارش می‌شود و استودیو
# با «سنتزِ محلیِ فال‌بک» کار می‌کند (سرور سالم می‌ماند — GET /ai/status).
#
# میان‌برِ تک‌گیت‌وی (روترهای چندمدلی مثل ۹روتر) — کافی است این ۴ متغیر:
KIAN_AI_BASE_URL=                 # e.g. https://your-router.up.railway.app/v1
KIAN_AI_API_KEY=                  # کلید روتر — اسلات‌های primary/fallback وارث آن؛ لیست کاما مجاز
KIAN_AI_MODEL=                    # مدل(های) اصلی — e.g. alicode/glm-5 یا m1,m2,m3
KIAN_AI_FALLBACK_MODEL=           # مدل(های) ثانویه روی همان روتر — e.g. oc/deepseek-v4.1-flash-free,oc/glm-5.3-flash-free
# (اختیاری) URL/کلید جدا برای اسلات fallback:
KIAN_AI_FALLBACK_URL=
KIAN_AI_FALLBACK_KEY=
#
# کنترل ریز اسلات‌ها — بر میان‌برهای بالا مقدم است (KEY/MODEL لیست کاما مجاز؛
# معماری استخرِ brain.py: ضرب دکارتیِ «هر مدل × هر کلید» یک استخر تختِ فال‌بک
# می‌سازد؛ برندهٔ آخر last_good دفعهٔ بعد اول امتحان می‌شود؛ پاسخ خراب با گیت
# کیفیت رد می‌شود و کم‌ضررترینِ موجود نجات می‌یابد — GET /ai/status → poolSize):
KIAN_AI_PRIMARY_URL=              # e.g. https://openrouter.ai/api/v1
KIAN_AI_PRIMARY_KEY=              # e.g. sk-or-v1-... (یا k1,k2 برای چرخش)
KIAN_AI_PRIMARY_MODEL=            # e.g. openrouter/free,baidu/ernie-5.5-flash-preview:free,particle-ai/particle-1:free
KIAN_AI_SECONDARY_URL=            # اسلات فال‌بک ۲
KIAN_AI_SECONDARY_KEY=
KIAN_AI_SECONDARY_MODEL=          # e.g. oc/deepseek-v4.1-flash-free,oc/glm-5.3-flash-free,oc/longcat-2.5-free
KIAN_AI_TERTIARY_URL=             # اسلات فال‌بک ۳ — e.g. https://coarena.ai/api/v1 (۵$ اعتبار روزانهٔ رایگان)
KIAN_AI_TERTIARY_KEY=
KIAN_AI_TERTIARY_MODEL=           # e.g. gpt-6-luna,gpt-6-1-sol,gemini-3-8-flash
#
# تامین‌کننده‌های سبک ShopifyHermes (اختیاری) — اگر حاضر باشند به انتهای استخر
# افزوده می‌شوند (ترتیب: coarena ← openrouter ← router9)؛ بدون کلید نادیده گرفته می‌شوند:
KIAN_AI_COARENA_URL=              # پیش‌فرض https://coarena.ai/api/v1
KIAN_AI_COARENA_KEY=
KIAN_AI_COARENA_KEYS=
KIAN_AI_COARENA_MODELS=           # e.g. gpt-6-luna,gemini-3-8-flash
KIAN_AI_OPENROUTER_URL=           # پیش‌فرض https://openrouter.ai/api/v1
KIAN_AI_OPENROUTER_KEY=
KIAN_AI_OPENROUTER_KEYS=
KIAN_AI_OPENROUTER_MODELS=        # e.g. qwen/qwen-2.5-coder-32b-instruct:free,...
KIAN_AI_ROUTER9_URL=
KIAN_AI_ROUTER9_KEY=
KIAN_AI_ROUTER9_KEYS=
KIAN_AI_ROUTER9_MODELS=           # e.g. oc/deepseek-v4.1-flash-free,oc/glm-5.3-flash-free
#
# سقف روزانهٔ توکن کل استخر — پیش‌فرض ۵۰٬۰۰۰:
KIAN_AI_DAILY_TOKENS=50000

# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 4 — P3: TELEGRAM BOT & MINI-APP (TMA) BRIDGE]
#  پل تلگرام — احراز TMA HMAC، وبهوک fail-closed و دکمهٔ مینی‌اپ.
# ═══════════════════════════════════════════════════════════════════════════
KIAN_BOT_TOKEN=                   # توکن @BotFather — مبنای HMAC احراز initData (fail-closed؛ هرگز لاگ یا روی سیم نمی‌رود)
KIAN_BOT_WEBHOOK_SECRET=          # راز وبهوک رسمی تلگرام (≥۱۶ کاراکتر) — هدر X-Telegram-Bot-Api-Secret-Token (fail-closed)
KIAN_MINIAPP_URL=                 # URL عمومی مینی‌اپ برای دکمهٔ WebApp بات — پیش‌فرض localhost:3000
KIAN_KERNEL_URL=http://127.0.0.1:8088  # آدرس کرنل برای شِل polling بات + پنل ادمین (فقط دیپلوی جدا)
NEXT_PUBLIC_KIAN_API=http://127.0.0.1:8088/api/v1  # پایهٔ API کرنل برای کلاینت مینی‌اپ (build-time)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=  # یوزرنیم بات بدون @ — لینک‌های وایرال ?startapp=p_<id>_r_<ref>

# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 5 — P4: NON-CUSTODIAL TREASURY & MULTI-CHAIN RAILS]
#  خزانهٔ غیر-امانیتی — فقط آدرس‌های عمومی برای واریز؛ صفر کلید خصوصی روی سرور.
# ═══════════════════════════════════════════════════════════════════════════
KIAN_TON_TREASURY=                # آدرس عمومی خزانهٔ TON — واریزهای مینی‌اپ به همین آدرس ضرب می‌شود
KIAN_TON_TO_DIN=1000              # نرخ ضرب مادهٔ ۳ — دیین به‌ازای هر ۱ TON — پیش‌فرض ۱۰۰۰
KIAN_USDT_TO_DIN=1000             # نرخ ضرب — دیین به‌ازای هر ۱ USDT — پیش‌فرض ۱۰۰۰
KIAN_TREASURY_TRX=                # خزانهٔ عمومی TRON (TRC-20) — خالی = آن زنجیره در GET /wallet/treasury باطل (null)
KIAN_TREASURY_SOL=                # خزانهٔ عمومی Solana (SPL)
KIAN_TREASURY_TON=                # خزانهٔ عمومی Jetton USDT روی TON
KIAN_TREASURY_BSC=                # خزانهٔ عمومی BNB Chain (BEP-20)
KIAN_NATION_QUORUM=3              # نصاب پارلمان HITL — پیش‌فرض ۳

# ═══════════════════════════════════════════════════════════════════════════
# [PRIORITY 6 — P5: RUNTIME GOVERNANCE, TELEMETRY & FRONTEND BUILD VARS]
#  تیونینگ پیشرفته — همه اختیاری با پیش‌فرض‌های تولیدِ امن.
#  NEXT_PUBLIC_* در زمان BUILD خوانده می‌شوند — بعد از تغییر redeploy لازم است.
# ═══════════════════════════════════════════════════════════════════════════
KIAN_SESSION_TTL_HOURS=168        # عمر نشست bearer به ساعت — پیش‌فرض ۱۶۸ (۷ روز)
KIAN_RATE_LIMIT=120               # سقف درخواست در پنجرهٔ ۶۰ثانیه‌ای هر باکت — پیش‌فرض ۱۲۰
RUST_LOG=info,kian_server=info,kian_hermes=info,kian_ai=info  # فیلتر لاگ tracing — پیش‌فرض info
RAILPACK_CARGO_WORKSPACE=kian-server  # متغیر بیلد Railpack — انتخاب قطعی باینری دیپلوی از ورک‌اسپیس
NEXT_PUBLIC_SITE_URL=             # apps/web — آدرس عمومی خود سایت (build-time)
NEXT_PUBLIC_KIAN_URL=             # apps/web — آدرس عمومی کرنل در اشتراک‌ها (build-time)
NEXT_PUBLIC_KERNEL_URL=http://127.0.0.1:8088  # apps/admin — پایهٔ API کرنل با هدر X-KIAN-Key (build-time)
KIAN_STUDIO_DEFAULT_TIER=auto     # استودیوی ادراک‌سیار (Wave 5) — auto | ToySpark | CreatorStudio | ProTerminal — پیش‌فرض auto (استنتاج از تلمتری)
KIAN_STUDIO_MAX_ARTIFACT_BYTES=   # سقف بایت آرتیفکت استودیو — خالی = پیش‌فرض ۲۵۶ کیلوبایت
KIAN_PORTFOLIO_CATALOG_PATH=      # ویترین پورتفولیو (Fix #1) — مسیر کاتالوگ؛ خالی = ./seed/portfolio_catalog (صفر گریز والد)
KIAN_STUDIO_STOREFRONT_DEFAULT_XTR=50  # قیمت پیش‌فرض ستارهٔ یک‌کلیکی ToySpark — پیش‌فرض ۵۰
