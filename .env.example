# KIAN — Environment Configuration (never commit real secrets; use KMS/Railway Variables in prod)
# Every variable below is actively read by kian-server (config.rs), kian-ai (gateway.rs), or apps/*.
#
# «شبِ تستِ محلی»: کافیست این فایل را به .env کپی کنید — مقادیر پیش‌فرضِ زیر
# کل چرخهٔ سازنده→انتشار→خرید→برداشت را بدون تلگرام و بدون کلید واقعی باز می‌کند.

# ── Core Server & Security ────────────────────────────────────────────────
# کلید دمو برای تستِ امشب (پیشوند dev- = کلید آزمایشی با حداقل ۸ کاراکتر).
# در تولید کلید ≥۱۶ کاراکتری تصادفی بگذارید: KIAN_ADMIN_KEY=<openssl rand -hex 24>
KIAN_ADMIN_KEY=dev-admin-key
# حالت توسعه/دمو — اندپوینت‌های /auth/dev-login و /wallet/faucet را فعال می‌کند.
# وقتی KIAN_BOT_TOKEN تنظیم نشده باشد خودبه‌خود هم فعال است؛ در تولید حتماً false/حذف.
KIAN_DEV_MODE=true
KIAN_DATABASE_URL=        # SQLite path — default: data/kian.sqlite (WAL enabled automatically)
KIAN_HOST=0.0.0.0         # Bind address — default: 127.0.0.1 (use 0.0.0.0 in Docker/Railway)
KIAN_PORT=8088            # HTTP listen port — default: 8088 (Railway injects PORT automatically)
KIAN_ALLOWED_ORIGINS=     # Comma-separated CORS allowlist (e.g. https://app.yourdomain.com)
KIAN_RATE_LIMIT=120       # Requests/minute per bucket — default: 120
KIAN_BACKUP_DIR=data/backups
KIAN_KEEP_BACKUPS=7
KIAN_TRUST_PROXY=true     # Trust X-Forwarded-For behind Railway/reverse proxy (set false if direct)

# ── Telegram Identity, Sessions & Bot ─────────────────────────────────────
KIAN_BOT_TOKEN=           # Telegram Bot token for WebApp initData HMAC (fail-closed if unset)
KIAN_BOT_WEBHOOK_SECRET=  # Telegram webhook secret token (>= 16 chars; fail-closed if unset)
KIAN_SESSION_TTL_HOURS=168 # Citizen Bearer session TTL in hours — default: 168 (7 days)
KIAN_MINIAPP_URL=         # Public MiniApp HTTPS URL for Telegram bot WebApp buttons
KIAN_KERNEL_URL=http://127.0.0.1:8088 # Kernel base URL for polling bot shell + admin panel

# ── Treasury, Crypto Deposits & Governance ────────────────────────────────
KIAN_TON_TREASURY=        # Public TON treasury address (non-custodial; no private key on server)
KIAN_TON_TO_DIN=1000      # Mint rate for TON deposits (Đ per 1 TON) — default: 1000
KIAN_USDT_TO_DIN=1000     # Mint rate for USDT deposits (Đ per 1 USDT) — default: 1000
KIAN_TREASURY_TRX=        # Public TRON (TRC-20) USDT treasury address
KIAN_TREASURY_SOL=        # Public Solana (SPL) USDT treasury address
KIAN_TREASURY_TON=        # Public TON Jetton USDT treasury address
KIAN_TREASURY_BSC=        # Public BNB Chain (BEP-20) USDT treasury address
KIAN_NATION_QUORUM=3      # Parliament proposal quorum — default: 3

# ── AI Gateway (OpenAI-compatible 3-slot automatic failover) ──────────────
# خالی بگذارید تا استودیوی AI با «سنتزِ محلیِ فال‌بک» کار کند — بدون کلید هم HTML می‌سازد.
#
# میان‌برِ تک‌گیت‌وی (برای روترهای چندمدلی مثل ۹روتر) — کافی است این ۴ متغیر:
KIAN_AI_BASE_URL=        # e.g. https://your-router.up.railway.app/v1
KIAN_AI_API_KEY=         # router API key (primary + fallback slots inherit it)
KIAN_AI_MODEL=           # primary model id, e.g. alicode/glm-5
KIAN_AI_FALLBACK_MODEL=  # secondary model on the same router, e.g. oc/deepseek-v4.1-flash-free
# (اختیاری) URL/کلید جدا برای اسلات fallback: KIAN_AI_FALLBACK_URL / KIAN_AI_FALLBACK_KEY
#
# کنترل ریز اسلات‌ها — بر میان‌برهای بالا مقدم است:
KIAN_AI_PRIMARY_URL=      # e.g. https://openrouter.ai/api/v1
KIAN_AI_PRIMARY_KEY=      # Primary provider API key
KIAN_AI_PRIMARY_MODEL=    # e.g. anthropic/claude-3.5-sonnet or openai/gpt-4o-mini
KIAN_AI_SECONDARY_URL=    # Optional failover slot #2
KIAN_AI_SECONDARY_KEY=
KIAN_AI_SECONDARY_MODEL=
KIAN_AI_TERTIARY_URL=     # Optional failover slot #3
KIAN_AI_TERTIARY_KEY=
KIAN_AI_TERTIARY_MODEL=
KIAN_AI_DAILY_TOKENS=50000 # Daily token budget across all slots — default: 50000

# ── Next.js MiniApp / Admin / Web (Build-Time Public Variables) ───────────
NEXT_PUBLIC_KIAN_API=http://127.0.0.1:8088/api/v1   # Public kernel API base for miniapp SDK
NEXT_PUBLIC_KERNEL_URL=http://127.0.0.1:8088        # Kernel base for admin panel (X-KIAN-Key)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=  # Bot username without @ (for ?startapp=p_<id>_r_<ref> links)
